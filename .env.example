# PostgreSQL service created in Dokploy. Keep this secret out of Git.
DATABASE_URL=postgresql://fha_user:replace-me@postgres:5432/fha
DATABASE_SSL=false

# Private /admin account. Use a unique long password and a random 32+ character session secret.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-unique-long-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Resend email delivery. Use a verified sender domain in production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Finding Hope Africa <website@findinghopeafrica.org>
ADMIN_ALERT_EMAIL=info@findinghopeafrica.org
PUBLIC_SITE_URL=https://findinghopeafrica.org

# Cloudflare R2 S3 API credentials and public custom domain (for example https://media.findinghopeafrica.org).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fha-blog-images
R2_PUBLIC_BASE_URL=

# Authorize.Net credentials. Configure the webhook URL below and copy its Signature Key here.
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_SIGNATURE_KEY=
AUTHORIZE_NET_MODE=sandbox
